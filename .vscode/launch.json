{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Run Report",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/orchastration.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env"
        }
    ]
}
